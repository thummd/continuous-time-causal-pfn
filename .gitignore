__pycache__/
*.pyc
*.egg-info/
dist/
build/
*.pt
checkpoints/
# Allow s4 and s5 sanity checkpoints via LFS
!checkpoints/s4_*/
!checkpoints/s4_*/*.pt
!checkpoints/s4_*/*.csv
!checkpoints/s5_*/
!checkpoints/s5_*/*.pt
!checkpoints/s5_*/*.csv
/data/*
# Bundle small public PK datasets used for zero-shot eval (phase 4).
!/data/pk_pd/
/data/pk_pd/*
!/data/pk_pd/*.csv
.pytest_cache/
identifiability.tex

.env
# The root-level `env` file holds OVERLEAF_GIT_TOKEN — never commit it.
/env
wandb/
logs/

# Session / editor / OS artifacts
.claude/
.ipynb_checkpoints/
.DS_Store
*.swp

# Large archives — never commit data/release zips (e.g. grid_v4.zip)
*.zip

# Internal / unpublished — not part of the public release.
# The paper is published on OpenReview and arXiv; internal planning notes
# and deploy config are kept out of the public repository.
paper/
PHASE_*_PLAN.md
chamber_table.md
results_aggregation.ipynb
.rsyncignore
